def init(module):
    module.name = ":board:nucleo-h743zi"
    module.description = """\
# NUCLEO-H743ZI

[Nucleo kit for STM32H743ZI](https://www.st.com/en/evaluation-tools/nucleo-h743zi.html)

This BSP targets revision Y of the STM32H743 and configures the core for
400MHz at VOS1. The same conservative operating point is valid on later
silicon revisions.

See the [STM32H743 errata sheet](https://www.st.com/resource/en/errata_sheet/es0392-stm32h742x743xig-st32h750xb-and-stm32h753xi-device-errata-stmicroelectronics.pdf).

Use the NUCLEO-H743ZI2 BSP for the revision-V MB1364 board and its 480MHz
configuration.
"""

def prepare(module, options):
    if not options[":target"].partname.startswith("stm32h743zit"):
        return False

    module.depends(
        ":debug",
        ":architecture:clock",
        ":platform:core",
        ":platform:gpio",
        ":platform:clock",
        ":platform:uart:3",
        ":platform:usb:fs")

    return True

def build(env):
    env.outbasepath = "modm/src/modm/board"
    env.substitutions = {
        "with_logger": True,
        "with_assert": env.has_module(":architecture:assert"),
        "board" : "stm32h743zi"
    }

    env.template("../board.cpp.in", "board.cpp")
    env.template("board.hpp.in")
    env.template("../stm32h7_ldo_startup.sx.in", "startup.sx", substitutions={
        "schematic": "MB1137-H743ZI-B01 schematic",
        "reference_manual": "RM0433"
    })
    env.copy("../nucleo144_arduino.hpp", "nucleo144_arduino.hpp")
    env.collect(":build:openocd.source", "board/st_nucleo_h743zi.cfg")
