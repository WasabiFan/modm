def init(module):
    module.name = ":board:devebox-stm32h750vb"
    module.description = """
# STM32H750VB mcudev DevEBox

[STM32H750VB mcudev DevEBox H7xx](https://github.com/mcauser/MCUDEV_DEVEBOX_H7XX_M)

This BSP targets revision Y of the STM32H750 and configures the core for
400MHz at VOS1. The same conservative operating point is valid on later
silicon revisions.

See the [STM32H750 errata sheet](https://www.st.com/resource/en/errata_sheet/es0392-stm32h742x743xig-st32h750xb-and-stm32h753xi-device-errata-stmicroelectronics.pdf).

This board has no serial port and logs via RTT instead.
"""

def prepare(module, options):
    if not options[":target"].partname.startswith("stm32h750vbt"):
        return False

    module.depends(
        ":debug",
        ":platform:clock",
        ":platform:core",
        ":platform:gpio",
        ":platform:rtt",
        ":platform:uart:1")

    return True

def build(env):
    env.outbasepath = "modm/src/modm/board"
    env.substitutions = {
        "with_logger": True,
        "with_assert": env.has_module(":architecture:assert")
    }
    env.template("../board.cpp.in", "board.cpp")
    env.template("../stm32h7_ldo_startup.sx.in", "startup.sx", substitutions={
        "schematic": "MCUDEV DevEBox STM32H7XX_M schematic",
        "reference_manual": "RM0433"
    })
    env.copy('.')

    env.outbasepath = "modm/openocd/modm/board/"
    env.template(repopath("tools/openocd/modm/stm32_swd.cfg.in"), "board.cfg",
                 substitutions={"target": "stm32h7x"})
    env.collect(":build:openocd.source", "modm/board/board.cfg")
